---
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile } from "../data/profile";
import { research } from "../data/research";
import { news } from "../data/news";
import { publishedPosts } from "../data/posts";

const recentNews = news
  .slice()
  .sort((a, b) => +new Date(b.date) - +new Date(a.date))
  .slice(0, 4);

const recentPosts = publishedPosts.slice(0, 2);

function fmt(iso: string) {
  return new Date(iso).toLocaleDateString("en-US", { year: "numeric", month: "short" });
}
function fmtFull(iso: string) {
  return new Date(iso).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
}
---

<BaseLayout current="home" title={profile.name}>
  <!-- ─── Identity ─────────────────────────────────────────── -->
  <section class="hero">
    <div class="hero-portrait">
      <img src={profile.portrait} alt={`Portrait of ${profile.name}`} />
    </div>

    <div>
      <h1 class="hero-name">{profile.name}</h1>
      <p class="hero-kicker">
        {profile.role} · {profile.affiliation}
      </p>
      <p>{profile.blurb}</p>
      <p style="color:var(--text-muted); font-size:var(--fs-small);">
        Advised by <a href={profile.advisor.url}>{profile.advisor.name}</a>.
      </p>

      <div class="hero-links">
        {profile.links.map((l, i) => (
          <>
            {i > 0 && <span class="sep">·</span>}
            <a href={l.href}>{l.label}</a>
          </>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── Research overview ────────────────────────────────── -->
  <section class="overview-section">
    <div class="section-head">
      <h2>Research</h2>
      <a href="/research" class="section-link">all projects →</a>
    </div>

    <p class="section-intro">{profile.tagline}</p>

    <div class="theme-list">
      {research.map(theme => (
        <article class="theme">
          <h3>
            <a href={`/research#${theme.slug}`}>{theme.title}</a>
          </h3>
          <p>{theme.summary}</p>
          <div class="theme-tags">{theme.tags.join(" · ")}</div>
        </article>
      ))}
    </div>
  </section>

  <!-- ─── Recent news ──────────────────────────────────────── -->
  <section class="overview-section">
    <div class="section-head">
      <h2>Recent</h2>
    </div>

    <ul class="news-list">
      {recentNews.map(item => (
        <li>
          <time datetime={item.date}>{fmt(item.date)}</time>
          <span>
            {item.href ? <a href={item.href}>{item.text}</a> : item.text}
          </span>
        </li>
      ))}
    </ul>
  </section>

  <!-- ─── Writing ──────────────────────────────────────────── -->
  {recentPosts.length > 0 && (
    <section class="overview-section">
      <div class="section-head">
        <h2>Writing</h2>
        <a href="/blog" class="section-link">all posts →</a>
      </div>

      <ul class="post-list">
        {recentPosts.map(p => (
          <li>
            <a href={`/blog/${p.slug}`}>
              <strong>{p.title}</strong>
              <div style="color:var(--text-muted); margin-top:0.25rem; font-size:var(--fs-small);">
                {p.summary}
              </div>
            </a>
            <time datetime={p.date}>{fmtFull(p.date)}</time>
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- ─── Contact ──────────────────────────────────────────── -->
  <section class="overview-section">
    <div class="section-head">
      <h2>Contact</h2>
    </div>
    <p>
      Best reached by <a href="mailto:pradyutkumar01@gmail.com">email</a>. I'm always
      glad to talk modelling, malaria, or why a biologist should befriend a differential equation.
    </p>
  </section>
</BaseLayout>
