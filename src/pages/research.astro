---
import BaseLayout from "../layouts/BaseLayout.astro";
import { research } from "../data/research";
---

<BaseLayout current="research" title="Research · Pradyut Kumar">
  <h1>Research &amp; projects</h1>

  <p class="article-meta">
    The themes I'm actively working on. Each summary on the home page links here.
  </p>

  {research.map(theme => (
    <article class="project" id={theme.slug}>
      <h3>
        {theme.title}
        {theme.status && <span class="project-status">{theme.status}</span>}
      </h3>
      <p>{theme.detail}</p>
      <div class="tags">{theme.tags.join(" · ")}</div>
    </article>
  ))}

  <p style="margin-top:2.5rem; color:var(--text-muted); font-style:italic;">
    More coming soon — active or past projects, whether published or still on the whiteboard.
  </p>
</BaseLayout>
